# Add this block to ~/.codex/config.toml and replace the binary/state paths.
[mcp_servers.navichrome]
command = "/absolute/path/to/navichrome"
args = ["mcp"]
startup_timeout_sec = 20
tool_timeout_sec = 120

[mcp_servers.navichrome.env]
NAVICHROME_STATE_DIR = "/absolute/path/to/navichrome-state"
NAVICHROME_AGENT_SURFACE = "v3-compact"
NAVICHROME_BROWSER_MODE = "foreground"
