{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "navichrome": {
      "type": "local",
      "command": ["/absolute/path/to/navichrome", "mcp"],
      "enabled": true,
      "environment": {
        "NAVICHROME_STATE_DIR": "/absolute/path/to/navichrome-state",
        "NAVICHROME_AGENT_SURFACE": "v3-compact"
      }
    }
  }
}
